GROQ_API_KEY=
GEMINI_API_KEY=
GROQ_STT_MODEL=whisper-large-v3
GEMINI_LLM_MODEL=gemini-2.5-flash
KOKORO_TTS_URL=http://host.docker.internal:8888/v1/audio/tts
VOICE_WEBHOOK_TOKEN=replace-with-a-long-random-secret
CORS_ALLOW_ORIGINS=http://localhost:3000,http://localhost:5173

# Optional async scheduled pod callbacks. Disabled by default.
APP_ENV=development
POD_SCHEDULER_ENABLED=false
POD_JOB_WEBHOOK_URL=
POD_JOB_WEBHOOK_TOKEN=
SWARN_AUDITOR_INTERVAL_SECONDS=3600
LUCAS_GROWTH_INTERVAL_SECONDS=21600
SWARN_AUDITOR_PROMPT=Review configured operational audit signals and return a concise findings summary.
LUCAS_GROWTH_PROMPT=Review configured growth signals and return a concise experiment and content-opportunity summary.
