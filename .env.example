# Copy to backend/.env or configure in your local secret manager.
# Never commit real credentials.

# OpenAI-compatible model provider (disabled unless explicitly enabled)
GIA_AGENT_PROVIDER_ENABLED=false
GIA_AGENT_BASE_URL=
GIA_AGENT_MODEL=
GIA_AGENT_API_KEY=

# Gemini prompt-evolution proposals; prompts still require human review
GEMINI_API_KEY=

# Supabase Studio prompt mirror (optional; local SQLite remains available)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STUDIO_PROMPTS_TABLE=studio_pod_prompts

# Virtual VoIP webhooks. Use a high-entropy secret and vendor-specific adapter.
GIA_VOIP_PROVIDER=
GIA_VOIP_WEBHOOK_SECRET=

# Voice providers (configuration presence is not a successful end-to-end test)
GROQ_API_KEY=
KOKORO_TTS_URL=

# WhatsApp Business Platform
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
